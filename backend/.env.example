# Backend Environment Variables

# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# API Prefix
API_PREFIX=/api

# CORS Origin (use * for all origins, or specific URL)
CORS_ORIGIN=*

# Database Directory (for local SQLite file mode)
DATA_DIR=./data

# Turso cloud database (optional; set both to persist data on Render)
# LIBSQL_URL=libsql://your-db-yourorg.turso.io
# LIBSQL_AUTH_TOKEN=your-turso-token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Configuration (DeepSeek or OpenAI)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your_api_key_here
AI_MODEL=deepseek-chat

# Pricing Model
FX_RATE=6.7
AIR_RATE_CNY_PER_KG=50
SEA_RATE_CNY_PER_KG=20
VOLUMETRIC_DIVISOR=5000
MARKUP_AIR=1.4
MARKUP_SEA=1.25
MID_STRATEGY=linear
ROUNDING=cent05
QTY_LEVELS_MODE=auto
AIR_QTY_LEVELS=4
